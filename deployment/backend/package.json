{
  "name": "shlloka-yatra-server",
  "version": "1.0.0",
  "description": "Backend API for Shlloka Yatra Pilgrimage Portal",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "node src/seed.js",
    "test": "node --test tests/admin_management_system.test.js tests/single_admin_auth.test.js tests/temporary_offline_payment_mode.test.js tests/member_registration_and_admin.test.js tests/offline_payment_workflow.test.js",
    "test:unit": "node --test tests/admin_management_system.test.js tests/single_admin_auth.test.js",
    "test:api": "node --test tests/temporary_offline_payment_mode.test.js tests/offline_payment_workflow.test.js",
    "test:integration": "node --test tests/member_registration_and_admin.test.js",
    "test:e2e": "node --test tests/temporary_offline_payment_mode.test.js tests/admin_management_system.test.js",
    "test:all": "npm test"
  },
  "dependencies": {
    "@clerk/backend": "^3.32.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.16.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.3.2"
  }
}
