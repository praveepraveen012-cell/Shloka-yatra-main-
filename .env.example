# Shloka Yatra 2027 Environment Configuration

# Application Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (SQLite for zero-config local dev & testing; PostgreSQL for production)
DATABASE_URL="file:../prisma/dev.db"
# DATABASE_URL="postgresql://username:password@localhost:5432/shlloka_yatra?schema=public"

# Application Internal JWT & Security
JWT_SECRET=shlloka_yatra_secure_production_secret_key_2027_kailash
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@shlloka.com
ADMIN_DEFAULT_PASSWORD=ShllokaAdmin@2027

# Clerk Authentication Provider (https://clerk.com)
# Obtain these from your Clerk Dashboard > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Payment Gateway (Razorpay & Sandbox Simulation)
# Mode: "sandbox" for simulated testing or "live" for production
PAYMENT_GATEWAY_MODE=sandbox
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Transactional Email Service (Configurable SMTP)
EMAIL_SERVICE_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_username
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM="Shloka Yatra <volunteers@shlloka.com>"
